#!/usr/bin/env bash
# Headless STL/3MF/SCAD screenshots. See tools/cloud/render.mjs --help.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$here/cloud/need" render
# A Playwright installed with `npm i -g` is not on Node's default resolution path.
node -e "require('playwright')" 2>/dev/null || export NODE_PATH="$(npm root -g)${NODE_PATH:+:$NODE_PATH}"
exec node "$here/cloud/render.mjs" "$@"
